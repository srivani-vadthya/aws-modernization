# ==============================================================================
# UNIFIED MODERNIZATION REPOSITORY .GITIGNORE
# Protects secrets, build outputs, local virtual environments, and generated data
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# --- Python & Backend (apps/api) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
.conda/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# FastApi / App Generated State & Large Uploads
apps/api/data/engagements/
apps/api/data/*.zip
apps/api/data/*.json
!apps/api/data/.gitkeep
apps/api/data/tmp/

# --- Node / Frontend (apps/web & portal) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Vite / React / Next.js Build Outputs
dist/
apps/web/dist/
portal/.next/
portal/out/
.turbo/

# Next.js Cache & Environment
.next/
*.tsbuildinfo
next-env.d.ts

# --- Testing & Test Automation Artifacts ---
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.classpath
.cproject
.settings/

# --- OS-generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Logs & Temporary Files ---
logs/
*.log
*.tmp
*.bak
*.swp
*.patch
