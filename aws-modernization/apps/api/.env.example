```env
# Copy to .env and configure locally. Never commit credentials.

# --- AWS Bedrock ---
BEDROCK_API_KEY=
BEDROCK_KEY_NAME=
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
AWS_REGION=us-east-1
AWS_TRANSFORM_TENANT_ID=
AWS_TRANSFORM_SERVICE_PROFILE_ARN=
AWS_TRANSFORM_PORTAL_URL=

# --- Optional: Jira Integration ---
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Optional: Azure DevOps Integration ---
ADO_ORG=
ADO_PROJECT=
ADO_PAT=

# --- Optional: Bitbucket Integration ---
BITBUCKET_WORKSPACE=
BITBUCKET_REPO=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_TOKEN=

# --- Optional: GitHub Integration ---
GITHUB_REPO=
GITHUB_TOKEN=

# --- PostgreSQL - Azure Database for PostgreSQL Flexible Server ---
PGHOST=
PGUSER=
PGPORT=5432
PGDATABASE=
PGPASSWORD=
PG_SSLMODE=require
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=30
```