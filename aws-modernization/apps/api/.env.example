JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
BITBUCKET_WORKSPACE=
BITBUCKET_REPO=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_TOKEN=
GITHUB_REPO=
GITHUB_TOKEN=
