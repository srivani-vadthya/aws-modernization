# Copy to .env and configure locally. Never commit credentials or tokens.
# Use one LLM provider at a time. Leave optional integrations blank.
LLM_PROVIDER=bedrock
BEDROCK_API_KEY=
BEDROCK_KEY_NAME=
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_MODEL_FAST=amazon.nova-lite-v1:0
BEDROCK_MODEL_REASONING=amazon.nova-pro-v1:0
BEDROCK_MODEL_CODE=amazon.nova-pro-v1:0
AWS_REGION=us-east-1

# AWS Transform CLI uses the normal AWS credential/profile chain. The CLI must
# be installed and authenticated separately. .NET SDK 10+ is required locally
# by the current AWS Transform .NET modernization worker.
AWS_PROFILE=
AWS_TRANSFORM_PROFILE=
AWS_TRANSFORM_CLI_PATH=
AWS_TRANSFORM_TENANT_ID=
AWS_TRANSFORM_SERVICE_PROFILE_ARN=
AWS_TRANSFORM_PORTAL_URL=

# Browser authorization for protected modernization execution endpoints.
# Replace the placeholder with a long random token; paste that token only into
# the Code Modernization authorization field, never into frontend source.
EXECUTION_AUTH_TOKENS='{"replace-with-a-long-random-token":{"subject":"local-operator","permissions":["execution:read","execution:control"],"engagements":["*"]}}'

# --- Optional: push generated epics/features/user stories to a tracker (User Story Generation step) ---
# Leave blank to skip. Secrets live here / in the environment only; they are never stored in engagement data.
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
BITBUCKET_WORKSPACE=
BITBUCKET_REPO=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_TOKEN=
GITHUB_REPO=
GITHUB_TOKEN=
